# Copy this file to .env and fill in your keys.

# ---- FREE (default setup) ----
# Google Gemini API, free tier, no card needed -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- PAID (only if you switch providers in config.yaml) ----
# Claude (story ideas + scripts)  -> https://console.anthropic.com
ANTHROPIC_API_KEY=

# ElevenLabs (narration)          -> https://elevenlabs.io  (Profile > API keys)
ELEVENLABS_API_KEY=

# fal.ai (images + AI video clips) -> https://fal.ai/dashboard/keys
FAL_KEY=
